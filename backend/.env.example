# Copy this file to ".env" and fill in your own values

# Local MongoDB replica set: mongodb://127.0.0.1:27017/employee_management?replicaSet=rs0
# MongoDB Atlas:       mongodb+srv://<user>:<password>@cluster0.mongodb.net/employee_management
# Registration approvals use MongoDB transactions, which require a replica set or mongos.
MONGO_URI=mongodb://127.0.0.1:27017/employee_management?replicaSet=rs0

PORT=5000

# JWT — use a long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_random_64_char_secret
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Web client — required for Google Sign-In.
# GOOGLE_CLIENT_ID must match REACT_APP_GOOGLE_CLIENT_ID in the frontend.
# Create one at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID, "Web application").
# Authorized JavaScript origins and redirect URIs must include each frontend origin in CORS_ORIGIN.
# The popup code flow uses the calling page origin as its redirect_uri during code exchange.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: CORS origin (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Optional OpenAI-compatible EMS Assistant provider. Without these values the
# assistant uses deterministic EMS lookups and approved knowledge articles.
EMS_AI_BASE_URL=https://api.openai.com/v1
EMS_AI_API_KEY=
EMS_AI_MODEL=
EMS_AI_TIMEOUT_MS=15000
# Personal records remain out of provider prompts unless explicitly enabled.
EMS_AI_ALLOW_PERSONAL_DATA=false

# One-time initial Admin setup (generate a unique random key of at least 32 characters).
# Set INITIAL_ADMIN_SETUP_KEY to enable /setup; it is permanently disabled after an Admin exists.
INITIAL_ADMIN_SETUP_KEY=

# Optional CLI seed values. A password of at least 12 characters is required; no defaults are used.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
